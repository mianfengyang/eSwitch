import SwiftUI
import Combine

class CubeViewModel: ObservableObject {
    @Published var cubeState = CubeState()
    
    private let keyboardMonitor = KeyboardMonitor()
    private var switchWindow: NSWindow?
    private var refreshTimer: Timer?
    
    func start() {
        setupKeyboardMonitor()
        startRefreshTimer()
        
        DispatchQueue.main.asyncAfter(deadline: .now() + 0.5) {
            if !AccessibilityHelper.shared.isAccessibilityEnabled {
                AccessibilityHelper.shared.requestAccessibility()
            }
        }
    }
    
    func stop() {
        keyboardMonitor.stop()
        refreshTimer?.invalidate()
        hideSwitcher()
    }
    
    private func setupKeyboardMonitor() {
        keyboardMonitor.onShowSwitcher = { [weak self] in
            DispatchQueue.main.async {
                self?.handleCommandEsc()
            }
        }
        
        keyboardMonitor.onNextApp = { [weak self] in
            DispatchQueue.main.async {
                self?.handleCommandEsc()
            }
        }
        
        keyboardMonitor.onHideSwitcher = { [weak self] in
            DispatchQueue.main.async {
                self?.handleCommandReleased()
            }
        }
        
        keyboardMonitor.start()
    }
    
    private func handleCommandEsc() {
        if cubeState.isVisible {
            cubeState.rotateToNext()
        } else {
            showSwitcher()
        }
    }
    
    private func handleCommandReleased() {
        if cubeState.isVisible {
            activateCurrentApp()
            hideSwitcher()
        }
    }
    
    private func showSwitcher() {
        refreshApps()
        
        guard cubeState.appCount > 0 else {
            return
        }
        
        cubeState.isVisible = true
        cubeState.reset()
        showWindow()
    }
    
    private func hideSwitcher() {
        cubeState.isVisible = false
        hideWindow()
    }
    
    private func activateCurrentApp() {
        if let app = cubeState.currentApp {
            AppInfoService.shared.activateApp(app)
        }
    }
    
    private func refreshApps() {
        let apps = AppInfoService.shared.getRunningApps()
        cubeState.setApps(apps)
    }
    
    private func showWindow() {
        if switchWindow == nil {
            createWindow()
        }
        
        switchWindow?.makeKeyAndOrderFront(nil)
        NSRunningApplication.current.activate(options: [.activateIgnoringOtherApps])
    }
    
    private func hideWindow() {
        switchWindow?.orderOut(nil)
    }
    
    private func createWindow() {
        let panel = NSPanel(
            contentRect: NSRect(x: 0, y: 0, width: 600, height: 600),
            styleMask: [.borderless, .nonactivatingPanel],
            backing: .buffered,
            defer: false
        )
        
        panel.level = .floating
        panel.isOpaque = false
        panel.backgroundColor = NSColor.black.withAlphaComponent(0.5)
        panel.hasShadow = true
        panel.hidesOnDeactivate = false
        panel.collectionBehavior = [.canJoinAllSpaces, .fullScreenAuxiliary]
        panel.isMovableByWindowBackground = false
        
        let contentView = NSHostingView(rootView: CubeView(cubeState: cubeState))
        panel.contentView = contentView
        
        centerWindow(panel)
        
        self.switchWindow = panel
    }
    
    private func centerWindow(_ window: NSWindow) {
        guard let screen = NSScreen.main else { return }
        
        let screenFrame = screen.visibleFrame
        let windowFrame = window.frame
        
        let x = screenFrame.midX - windowFrame.width / 2
        let y = screenFrame.midY - windowFrame.height / 2
        
        window.setFrameOrigin(NSPoint(x: x, y: y))
    }
    
    private func startRefreshTimer() {
        refreshTimer = Timer.scheduledTimer(withTimeInterval: 2.0, repeats: true) { [weak self] _ in
            guard let self = self, self.cubeState.isVisible else { return }
            self.refreshApps()
        }
    }
}
