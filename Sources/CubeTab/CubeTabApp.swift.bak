import SwiftUI

@main
struct CubeTabApp: App {
    @NSApplicationDelegateAdaptor(AppDelegate.self) var appDelegate
    
    var body: some Scene {
        Settings {
            EmptyView()
        }
    }
}

class AppDelegate: NSObject, NSApplicationDelegate {
    private var viewModel: CubeViewModel?
    private var statusItem: NSStatusItem?
    
    func applicationDidFinishLaunching(_ notification: Notification) {
        viewModel = CubeViewModel()
        viewModel?.start()
        setupStatusItem()
    }
    
    func applicationWillTerminate(_ notification: Notification) {
        viewModel?.stop()
    }
    
    private func setupStatusItem() {
        statusItem = NSStatusBar.system.statusItem(withLength: NSStatusItem.squareLength)
        
        if let button = statusItem?.button {
            button.image = NSImage(systemSymbolName: "cube.fill", accessibilityDescription: "CubeTab")
        }
        
        let menu = NSMenu()
        
        let statusMenuItem = NSMenuItem(title: "CubeTab 运行中", action: nil, keyEquivalent: "")
        statusMenuItem.isEnabled = false
        menu.addItem(statusMenuItem)
        
        menu.addItem(NSMenuItem.separator())
        
        let accItem = NSMenuItem(title: "检查辅助功能权限", action: #selector(checkAccessibility), keyEquivalent: "")
        accItem.target = self
        menu.addItem(accItem)
        
        menu.addItem(NSMenuItem.separator())
        
        let quitItem = NSMenuItem(title: "退出", action: #selector(quit), keyEquivalent: "q")
        quitItem.target = self
        menu.addItem(quitItem)
        
        statusItem?.menu = menu
    }
    
    @objc private func checkAccessibility() {
        if AXIsProcessTrusted() {
            let alert = NSAlert()
            alert.messageText = "辅助功能权限已启用"
            alert.informativeText = "CubeTab 已获得辅助功能权限。\n\n使用 Command + esc 呼出切换器。"
            alert.alertStyle = .informational
            alert.runModal()
        } else {
            AccessibilityHelper.shared.requestAccessibility()
        }
    }
    
    @objc private func quit() {
        NSApplication.shared.terminate(nil)
    }
}
