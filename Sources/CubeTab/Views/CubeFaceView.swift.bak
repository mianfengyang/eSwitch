import SwiftUI

struct CubeFaceView: View {
    let appInfo: AppInfo
    let isCurrentFace: Bool
    
    var body: some View {
        VStack(spacing: 8) {
            if let icon = appInfo.icon {
                Image(nsImage: icon)
                    .resizable()
                    .aspectRatio(contentMode: .fit)
                    .frame(width: 80, height: 80)
                    .shadow(radius: isCurrentFace ? 10 : 0)
            } else {
                Rectangle()
                    .fill(Color.gray.opacity(0.3))
                    .frame(width: 80, height: 80)
                    .cornerRadius(12)
            }
            
            Text(appInfo.name)
                .font(.system(size: 12, weight: .medium))
                .foregroundColor(.white)
                .lineLimit(1)
                .truncationMode(.tail)
        }
        .frame(width: 150, height: 150)
        .background(
            RoundedRectangle(cornerRadius: 16)
                .fill(Color.black.opacity(isCurrentFace ? 0.7 : 0.4))
        )
        .scaleEffect(isCurrentFace ? 1.1 : 0.9)
    }
}
